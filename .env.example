# Nexus-bot Environment Configuration
# Copy this to .env and configure for your setup

# Database Configuration (only needed for inventory/order tools against THIS bot's Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexus_bot
DB_USER=postgres
DB_PASSWORD=

# LLM — pick Groq (cloud) OR Ollama (local). Groq wins if GROQ_API_KEY is set.
# This is NOT the same as API_KEY below.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Authentication: API keys for client applications
# Single key (backward compatible):
#   API_KEY=your-secret-key-here
# Multiple keys (for multiple client apps):
#   API_KEYS=kickskraze_key_abc123,other_app_key_xyz789,third_app_key_def456
# Generate keys with: openssl rand -base64 32
# Leave empty for local testing (auth disabled).
API_KEY=
# API_KEYS=

# CORS: Comma-separated allowed origins. Use * for development only.
# Production: Set to your actual frontend domains
# Example: CORS_ORIGINS=https://kickskraze.com,https://other-app.com
CORS_ORIGINS=*

# Vector store
VECTOR_PERSIST_DIR=./chroma_db
# Comma-separated data/ folder names to ingest. Empty = ingest every tenant.
# Local Kickskraze test: TENANT_IDS=kickskraze
TENANT_IDS=
