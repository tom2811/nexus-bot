# Nexus-bot environment. Copy to .env and fill in values.

# Postgres - only for this bot's inventory/order/search tools
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexus_bot
DB_USER=postgres
DB_PASSWORD=

# LLM - Groq when GROQ_API_KEY is set, otherwise local Ollama
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Per-request time budget in seconds (retries stay within it)
LLM_TIMEOUT=60
# Optional: override fallback order, e.g. groq:openai/gpt-oss-120b,ollama:llama3.2
LLM_PROVIDER_CHAIN=

# Auth - empty disables auth (dev only); API_KEYS accepts a comma-separated list
API_KEY=
# API_KEYS=

# Allowed browser origins (comma-separated; * for dev only)
CORS_ORIGINS=*

# Vector store
VECTOR_PERSIST_DIR=./chroma_db
DEFAULT_COLLECTION=general
# data/ subfolders to ingest as tenants (empty = all)
TENANT_IDS=
