# Nexus-bot Environment Configuration
# Copy this to .env and configure for your setup

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexus_bot
DB_USER=postgres
DB_PASSWORD=

# LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Security (Optional - leave empty for dev mode)
API_KEY=
CORS_ORIGINS=*
